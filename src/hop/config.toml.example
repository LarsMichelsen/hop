# Example configuration file for hop
# Place this file at: ~/.config/hop/config.toml

# UI options
[ui]
# Theme: "auto" (default — honours $HOP_THEME, otherwise adapts to the
# terminal's ANSI color palette via "ansi-dark"/"textual-ansi" depending on
# the installed Textual version), "light", "dark", or any built-in Textual
# theme name such as "nord", "gruvbox", "dracula", "monokai", "tokyo-night",
# "catppuccin-mocha", "catppuccin-latte", "solarized-light", "flexoki",
# "ansi-dark", "ansi-light", "textual-ansi".
theme = "auto"

# Default prefix for branches not specified in [branch_prefixes]
[defaults]
branch_prefix = ""

# Branch-specific prefixes
# Maps base branch names to prefixes for new branches created from them
[branch_prefixes]
main = "feature/"
master = "feature/"
develop = "feat/"
staging = "hotfix/"
production = "hotfix/"

# Quote branch names containing dots, slashes, or other special characters
# (unquoted, TOML splits keys like 2.5.0 at the dots):
# "release/v1.0" = "bugfix/"
# "2.5.0" = "bugfix/"
